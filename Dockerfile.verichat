# syntax=docker/dockerfile:1
# VeriChat serving image: chat with every claim scored by the model's internals, sourced and cited,
# plus /judge for answers from any model. CPU torch; on a GPU host use a CUDA base image instead.
#   docker build -f Dockerfile.verichat -t verichat .
#   docker run -p 8080:8080 -v $HOME/.cache/huggingface:/home/vt/.cache/huggingface verichat \
#       --model Qwen/Qwen2.5-7B-Instruct --head heads/Qwen2.5-7B-Instruct_claims_head.pt \
#       --detector heads/Qwen2.5-3B-Instruct_detector.pt [--corpus /docs]
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
RUN --mount=type=secret,id=pipca,required=false \
    if [ -f /run/secrets/pipca ]; then export PIP_CERT=/run/secrets/pipca; fi; \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1 && \
    pip install --no-cache-dir numpy==2.1.3 scipy==1.14.1 transformers==4.46.3 accelerate==1.1.1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY vt ./vt
COPY results/kaggle/claims-7b/claims/Qwen2.5-7B-Instruct_claims_head.pt \
     results/kaggle/detector-3b/detector/Qwen2.5-3B-Instruct_detector.pt ./heads/
RUN pip install --no-cache-dir --no-deps . && useradd --create-home --uid 10001 vt
USER vt
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=600s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2)"
ENTRYPOINT ["vt", "verichat", "--host", "0.0.0.0", "--port", "8080"]
CMD ["--model", "Qwen/Qwen2.5-7B-Instruct", "--head", "heads/Qwen2.5-7B-Instruct_claims_head.pt", \
     "--detector", "heads/Qwen2.5-3B-Instruct_detector.pt"]
