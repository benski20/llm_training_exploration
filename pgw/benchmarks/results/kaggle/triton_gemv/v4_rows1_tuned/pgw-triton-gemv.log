,{"stream_name":"stdout","time":508.85459228,"data":"dint(-128, 128, (m, n), dtype=torch.int8, generator=torch.Generator().manual_seed(9))\n"}
,{"stream_name":"stdout","time":508.854606792,"data":"        spec = LinearSpec(LinearId(0, LinearKind.O), m, n)\n"}
,{"stream_name":"stdout","time":508.854609898,"data":"        kern = ComputeKernel(spec, w8, device=\"cuda\", cuda_graphs=False)\n"}
,{"stream_name":"stdout","time":508.854612584,"data":"        off = ComputeKernel(spec, w8, device=\"cuda\", cuda_graphs=False, triton_gemv=False)\n"}
,{"stream_name":"stdout","time":508.854615199,"data":"        assert kern.triton_gemv and not off.triton_gemv\n"}
,{"stream_name":"stdout","time":508.854617596,"data":"        ex = device_executor(\"cuda:0\")\n"}
,{"stream_name":"stdout","time":508.854620192,"data":"        for k, ring in RINGS.items():\n"}
,{"stream_name":"stdout","time":508.854622548,"data":"            for b in (1, 2, 5, 8, 16, 17):\n"}
,{"stream_name":"stdout","time":508.854624902,"data":"                x, _ = _rand(b, 1, n, k, seed=b)\n"}
,{"stream_name":"stdout","time":508.854627281,"data":"                gemv0 = ex.stats.gemv\n"}
,{"stream_name":"stdout","time":508.854629754,"data":"                y = kern.run(x, ring)\n"}
,{"stream_name":"stdout","time":508.854632858,"data":"                np.testing.assert_array_equal(y.numpy(), ringmm_reference(x, w8, k))\n"}
,{"stream_name":"stdout","time":508.85465299,"data":"                assert torch.equal(kern.run_compact(x, ring), off.run_compact(x, ring))\n"}
,{"stream_name":"stdout","time":508.854657329,"data":"                assert ex.stats.gemv - gemv0 == (2 if b \u003c= max_rows(\"cuda:0\") else 0)\n"}
,{"stream_name":"stdout","time":508.854662254,"data":"        x, _ = _rand(3, 1, n, 40, seed=0)\n"}
,{"stream_name":"stdout","time":508.854666064,"data":"        gemv0 = ex.stats.gemv\n"}
,{"stream_name":"stdout","time":508.854670228,"data":"        np.testing.assert_array_equal(kern.run(x, RingParams(40, 12)).numpy(), ringmm_reference(x, w8, 40))\n"}
,{"stream_name":"stdout","time":508.854674441,"data":"        assert ex.stats.gemv == gemv0  # K \u003e 32: digit-GEMM path\n"}
,{"stream_name":"stdout","time":508.854678203,"data":"        # a wrong fused result on the first call of a (K, rows) disables the fast path on the device\n"}
