# /etc/pgw/factory.env: non-secret factory settings (mode 0640, root:pgw).
PGW_LOG_JSON=true
PGW_LOG_LEVEL=INFO
PGW_FACTORY_PACK_PATH=/var/lib/pgw/packs/llama3-8b
PGW_FACTORY_RING=K32A12C27
PGW_FACTORY_DEVICE=auto
PGW_FACTORY_SEGMENT_SLOTS=4096
PGW_FACTORY_LOW_WATER_SLOTS=16384
PGW_FACTORY_TARGET_SLOTS=65536
PGW_FACTORY_NICE=10
PGW_MASKSTORE_ROOT=/var/lib/pgw/masks
