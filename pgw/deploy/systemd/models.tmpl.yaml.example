# /etc/pgw/models.tmpl.yaml: rendered at start-up by `pgw config render` into /run/pgw/models.yaml
# (tmpfs, 0600). Secrets are references (${file:...} / ${env:...}), never literal values.
- name: llama3-8b
  pack_path: /var/lib/pgw/packs/llama3-8b
  fingerprint: "<64-hex fingerprint printed by pgw pack / pgw inspect>"
  ring: K32A12C27
  service_url: https://compute.pgw.example.net:8443
  service_token: "${file:/run/credentials/pgw-gateway.service/service-token}"
  service_ca_file: /etc/pgw/tls/service-ca.crt
  max_concurrent_sessions: 32
