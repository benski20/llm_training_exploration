# /etc/pgw/gateway.env: non-secret gateway settings (mode 0640, root:pgw). Secrets are systemd
# credentials (see pgw-gateway.service), never put them here.
PGW_LOG_JSON=true
PGW_LOG_LEVEL=INFO
PGW_GATEWAY_HOST=0.0.0.0
PGW_GATEWAY_PORT=8080
PGW_GATEWAY_MASKSTORE_ROOT=/var/lib/pgw/masks
PGW_MASKSTORE_ROOT=/var/lib/pgw/masks
# External monotonic counter: REQUIRED (the gateway refuses to hand out masks without one). Keep it on
# a different filesystem than /var/lib/pgw that is NOT part of snapshots/backups of the mask volume
# (or use PGW_MASKSTORE_COUNTER=tpm with PGW_MASKSTORE_TPM_NV_INDEX, or =provider with a KMS/HSM).
# If the mask volume is ever restored, burn every ACTIVE segment and rebind witnesses before serving.
PGW_MASKSTORE_COUNTER=file
PGW_MASKSTORE_COUNTER_FILE=/var/lib/pgw-counter/generation.counter
# Partner factory signing keys (hex or base64 Ed25519); partner segments must be signed by one:
# PGW_MASKSTORE_TRUSTED_PARTNER_KEYS=["<64-hex public key from 'pgw maskstore partner-key show'>"]
PGW_GATEWAY_API_KEYS_FILE=/var/lib/pgw/api_keys.json
PGW_GATEWAY_QUOTA_STATE_FILE=/var/lib/pgw/quota.json
PGW_GATEWAY_AUDIT_LOG_FILE=/var/lib/pgw/audit.jsonl
PGW_GATEWAY_REQUIRE_SERVICE_TLS=true
# Operator console at /console/ on the API port (same exposure as /admin; sign-in with the admin
# token credential). Keep the port on an internal network or behind an internal TLS reverse proxy.
PGW_GATEWAY_CONSOLE_ENABLED=true
# Read-only console users, one token per line (file mode 0640 root:pgw):
# PGW_GATEWAY_CONSOLE_VIEWER_TOKENS_FILE=/etc/pgw/console-viewers
# TLS for the API listener (recommended):
# PGW_GATEWAY_TLS__CERT_FILE=/etc/pgw/tls/tls.crt
# PGW_GATEWAY_TLS__KEY_FILE=/etc/pgw/tls/tls.key
