# /etc/pgw/gateway.env: non-secret gateway settings (mode 0640, root:pgw). Secrets are systemd
# credentials (see pgw-gateway.service), never put them here.
PGW_LOG_JSON=true
PGW_LOG_LEVEL=INFO
PGW_GATEWAY_HOST=0.0.0.0
PGW_GATEWAY_PORT=8080
PGW_GATEWAY_MASKSTORE_ROOT=/var/lib/pgw/masks
PGW_MASKSTORE_ROOT=/var/lib/pgw/masks
PGW_GATEWAY_API_KEYS_FILE=/var/lib/pgw/api_keys.json
PGW_GATEWAY_QUOTA_STATE_FILE=/var/lib/pgw/quota.json
PGW_GATEWAY_AUDIT_LOG_FILE=/var/lib/pgw/audit.jsonl
PGW_GATEWAY_REQUIRE_SERVICE_TLS=true
# TLS for the API listener (recommended):
# PGW_GATEWAY_TLS__CERT_FILE=/etc/pgw/tls/tls.crt
# PGW_GATEWAY_TLS__KEY_FILE=/etc/pgw/tls/tls.key
