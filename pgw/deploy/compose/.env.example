# Copy to .env and adjust. No secrets belong here: the demo generates its own keys and tokens.
PGW_DEMO_MODEL=Qwen/Qwen2.5-0.5B-Instruct
PGW_DEMO_RING=K40A12
# Masks are single use: one slot per prompt or generated token (1.5 MB per slot for 0.5B at K40).
PGW_DEMO_SLOTS=2048
PGW_DEMO_PORT=8080
PGW_LOG_LEVEL=INFO
