{
  "name": "pgw-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PGW Console: operator web console for the PGW gateway (static SPA served at /console/).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "vite build --mode mock --outDir .mock-dist --emptyOutDir",
    "preview:mock": "vite preview --mode mock --outDir .mock-dist --port 4174 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "build:demo": "vite build --mode demo --outDir .demo-dist --emptyOutDir"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
